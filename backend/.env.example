# Copy to backend/.env (gitignored) for local development.
# Start manual-dev Postgres first: from the repo root, `docker compose up -d postgres`
#
# Local Compose credentials only — do not use in production.
# Production: set DATABASE_URL to your hosted Postgres URL (e.g. Neon).

# Manual local API (`cargo run`) — Compose service `postgres` on host port 5432
# (named volume; data survives `docker compose down` unless you pass `-v`).
DATABASE_URL=postgres://ai_football_coach:ai_football_coach@127.0.0.1:5432/ai_football_coach

# Automated tests (`cargo test` / quality-tests) use a separate Compose service
# `postgres-test` on host port 5433 by default. Override with TEST_DATABASE_URL
# if needed; do not point DATABASE_URL at the test instance for manual work.
# TEST_DATABASE_URL=postgres://ai_football_coach:ai_football_coach@127.0.0.1:5433/ai_football_coach

# Optional: comma-separated browser origins allowed for local CORS (frontend → API).
# Defaults to http://localhost:3000 and http://127.0.0.1:3000 when unset.
# Example for a non-default Vite port:
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
