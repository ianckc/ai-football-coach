# Copy to backend/.env (gitignored) for local development.
# Start Postgres first: from the repo root, `docker compose up -d`
#
# Local Compose credentials only — do not use in production.
# Production: set DATABASE_URL to your hosted Postgres URL (e.g. Neon).

DATABASE_URL=postgres://ai_football_coach:ai_football_coach@127.0.0.1:5432/ai_football_coach

# Optional: comma-separated browser origins allowed for local CORS (frontend → API).
# Defaults to http://localhost:3000 and http://127.0.0.1:3000 when unset.
# Example for a non-default Vite port:
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

