# Copy to factory.env (gitignored) and fill in.

# GitHub Project (Issues on the board are the work queue)
FACTORY_PROJECT_OWNER=your-org-or-user
FACTORY_PROJECT_NUMBER=1

# Default repo for numeric ISSUE_REF values (owner/repo)
FACTORY_REPO=your-org/ai-football-coach

# Status single-select option labels on the Project (must match exactly)
FACTORY_STATUS_READY=Ready
FACTORY_STATUS_IN_PROGRESS=In Progress
FACTORY_STATUS_DONE=Done

# Optional: move board columns automatically (from `gh project … --format json`)
# FACTORY_PROJECT_ID=
# FACTORY_STATUS_FIELD_ID=
# FACTORY_STATUS_IN_PROGRESS_OPTION_ID=
# FACTORY_STATUS_DONE_OPTION_ID=
# Per-run: pass factory_item_id to run-ticket, or set FACTORY_ITEM_ID here for a single item
